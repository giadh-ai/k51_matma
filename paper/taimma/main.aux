\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Component ablation (test F1-score; y-axis truncated at 85 for readability). The full \text  {H-GNN} with hierarchical decomposition and global max-pooling attains 97.99\%; replacing global max-pooling with mean-pooling drops it to 95.77\%, and removing the hierarchical decomposition drops it to 89.62\% (mean of two seeds), confirming both design choices.}}{10}{figure.1.2}\protected@file@percent }
\newlabel{fig:ablation_study}{{2}{10}{Component ablation (test F1-score; y-axis truncated at 85 for readability). The full \text {H-GNN} with hierarchical decomposition and global max-pooling attains \hgnnF \%; replacing global max-pooling with mean-pooling drops it to \ablMean \%, and removing the hierarchical decomposition drops it to \ablNoHier \% (mean of two seeds), confirming both design choices}{figure.1.2}{}}
